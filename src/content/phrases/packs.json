[
  {
    "id": "phrases-first-meeting",
    "title": "First meeting",
    "situation": "Your first week: classmates, your buddy, people in the dorm. Introduce yourself and ask the usual first questions.",
    "dialogue": [
      {
        "speaker": "Minji",
        "korean": "안녕하세요. 저는 민지예요.",
        "meaning": "Hello. I'm Minji."
      },
      {
        "speaker": "You",
        "korean": "안녕하세요. 저는 아이다르예요. 카자흐스탄에서 왔어요.",
        "meaning": "Hello. I'm Aidar. I'm from Kazakhstan."
      },
      {
        "speaker": "Minji",
        "korean": "만나서 반가워요. 유니스트 학생이에요?",
        "meaning": "Nice to meet you. Are you a UNIST student?"
      },
      {
        "speaker": "You",
        "korean": "네, 교환학생이에요. 전공은 정보시스템이에요.",
        "meaning": "Yes, I'm an exchange student. My major is Information Systems."
      },
      {
        "speaker": "Minji",
        "korean": "와, 한국어 잘하네요!",
        "meaning": "Wow, your Korean is good!"
      },
      {
        "speaker": "You",
        "korean": "아니에요. 아직 잘 못해요. 잘 부탁해요.",
        "meaning": "Not at all, I'm not good yet. Nice to know you."
      }
    ],
    "phrases": [
      { "id": "phrase-meet-01", "korean": "안녕하세요.", "meaning": "Hello." },
      {
        "id": "phrase-meet-02",
        "korean": "처음 뵙겠습니다.",
        "meaning": "Nice to meet you (first meeting).",
        "note": "Very polite. Good for professors, staff and older people."
      },
      { "id": "phrase-meet-03", "korean": "만나서 반가워요.", "meaning": "Nice to meet you." },
      { "id": "phrase-meet-04", "korean": "이름이 뭐예요?", "meaning": "What is your name?" },
      {
        "id": "phrase-meet-05",
        "korean": "카자흐스탄에서 왔어요.",
        "meaning": "I'm from Kazakhstan."
      },
      {
        "id": "phrase-meet-06",
        "korean": "어느 나라에서 왔어요?",
        "meaning": "Which country are you from?"
      },
      {
        "id": "phrase-meet-07",
        "korean": "저는 교환학생이에요.",
        "meaning": "I'm an exchange student."
      },
      { "id": "phrase-meet-08", "korean": "전공이 뭐예요?", "meaning": "What is your major?" },
      { "id": "phrase-meet-09", "korean": "몇 학년이에요?", "meaning": "What year are you in?" },
      {
        "id": "phrase-meet-10",
        "korean": "한국어를 조금 해요.",
        "meaning": "I speak a little Korean."
      },
      {
        "id": "phrase-meet-11",
        "korean": "잘 부탁드려요.",
        "meaning": "I look forward to getting to know you.",
        "note": "Said at the end of an introduction. There is no exact English match."
      }
    ],
    "refs": ["grammar-02-copula", "grammar-03-topic", "grammar-13-questions"]
  },
  {
    "id": "phrases-dorm",
    "title": "Dorm check-in",
    "situation": "At the dormitory office: checking in, getting your key card, and asking about rooms, laundry and rules.",
    "dialogue": [
      {
        "speaker": "You",
        "korean": "안녕하세요. 교환학생이에요. 체크인하고 싶어요.",
        "meaning": "Hello. I'm an exchange student. I'd like to check in."
      },
      {
        "speaker": "Staff",
        "korean": "학생증이나 여권 있어요?",
        "meaning": "Do you have a student ID or a passport?"
      },
      { "speaker": "You", "korean": "네, 여기 있어요.", "meaning": "Yes, here you are." },
      {
        "speaker": "Staff",
        "korean": "방은 305호예요. 이건 카드 키예요.",
        "meaning": "Your room is 305. This is your key card."
      },
      {
        "speaker": "You",
        "korean": "감사합니다. 와이파이 비밀번호가 뭐예요?",
        "meaning": "Thank you. What is the Wi-Fi password?"
      },
      {
        "speaker": "Staff",
        "korean": "방에 있는 안내문에 있어요.",
        "meaning": "It's on the information sheet in your room."
      }
    ],
    "phrases": [
      {
        "id": "phrase-dorm-01",
        "korean": "체크인하고 싶어요.",
        "meaning": "I'd like to check in."
      },
      { "id": "phrase-dorm-02", "korean": "여기 있어요.", "meaning": "Here you are." },
      {
        "id": "phrase-dorm-03",
        "korean": "제 방이 몇 호예요?",
        "meaning": "What is my room number?"
      },
      { "id": "phrase-dorm-04", "korean": "열쇠를 잃어버렸어요.", "meaning": "I lost my key." },
      {
        "id": "phrase-dorm-05",
        "korean": "세탁실이 어디예요?",
        "meaning": "Where is the laundry room?"
      },
      {
        "id": "phrase-dorm-06",
        "korean": "와이파이 비밀번호가 뭐예요?",
        "meaning": "What is the Wi-Fi password?"
      },
      { "id": "phrase-dorm-07", "korean": "통금 시간이 있어요?", "meaning": "Is there a curfew?" },
      {
        "id": "phrase-dorm-08",
        "korean": "쓰레기는 어디에 버려요?",
        "meaning": "Where do I throw away rubbish?"
      },
      {
        "id": "phrase-dorm-09",
        "korean": "방에 문제가 있어요.",
        "meaning": "There is a problem with my room."
      },
      {
        "id": "phrase-dorm-10",
        "korean": "뜨거운 물이 안 나와요.",
        "meaning": "There is no hot water."
      }
    ],
    "refs": ["grammar-11-want", "grammar-14-existence"]
  },
  {
    "id": "phrases-restaurant",
    "title": "Cafeteria and restaurants",
    "situation": "Getting a table, ordering, asking about spice, and paying. In a campus cafeteria you often buy a meal ticket or pay at a machine first.",
    "dialogue": [
      {
        "speaker": "Staff",
        "korean": "어서 오세요. 몇 분이세요?",
        "meaning": "Welcome. How many people?"
      },
      { "speaker": "You", "korean": "두 명이요.", "meaning": "Two." },
      { "speaker": "Staff", "korean": "이쪽으로 앉으세요.", "meaning": "Please sit over here." },
      {
        "speaker": "You",
        "korean": "저기요, 메뉴판 좀 주세요.",
        "meaning": "Excuse me, the menu, please."
      },
      {
        "speaker": "You",
        "korean": "김치찌개 하나하고 비빔밥 하나 주세요.",
        "meaning": "One kimchi stew and one bibimbap, please."
      },
      { "speaker": "Staff", "korean": "네, 알겠습니다.", "meaning": "Certainly." },
      { "speaker": "You", "korean": "계산해 주세요.", "meaning": "The bill, please." }
    ],
    "phrases": [
      {
        "id": "phrase-food-01",
        "korean": "저기요!",
        "meaning": "Excuse me! (to call staff)",
        "note": "The normal, polite way to get a server's attention. Many places also have a call button on the table."
      },
      {
        "id": "phrase-food-02",
        "korean": "몇 분이세요?",
        "meaning": "How many people? (you will hear this)"
      },
      { "id": "phrase-food-03", "korean": "두 명이요.", "meaning": "Two people." },
      { "id": "phrase-food-04", "korean": "메뉴판 좀 주세요.", "meaning": "The menu, please." },
      { "id": "phrase-food-05", "korean": "이거 주세요.", "meaning": "This one, please." },
      {
        "id": "phrase-food-13",
        "korean": "물 좀 주세요.",
        "meaning": "Water, please.",
        "note": "In many restaurants water is self-service, from a dispenser or a jug on the table."
      },
      { "id": "phrase-food-06", "korean": "이거 매워요?", "meaning": "Is this spicy?" },
      { "id": "phrase-food-07", "korean": "안 맵게 해 주세요.", "meaning": "Not spicy, please." },
      {
        "id": "phrase-food-08",
        "korean": "식권은 어디서 사요?",
        "meaning": "Where do I buy a meal ticket?"
      },
      {
        "id": "phrase-food-09",
        "korean": "잘 먹겠습니다.",
        "meaning": "Thank you for the food. (before eating)",
        "note": "Said before a meal, especially when someone else is paying."
      },
      {
        "id": "phrase-food-10",
        "korean": "잘 먹었습니다.",
        "meaning": "Thank you for the meal. (after eating)"
      },
      { "id": "phrase-food-11", "korean": "포장해 주세요.", "meaning": "To take away, please." },
      { "id": "phrase-food-12", "korean": "계산해 주세요.", "meaning": "The bill, please." }
    ],
    "refs": ["grammar-12-requests"]
  },
  {
    "id": "phrases-cafe",
    "title": "Cafes",
    "situation": "Ordering coffee, choosing hot or iced, for here or to go, and finding a socket for your laptop.",
    "dialogue": [
      { "speaker": "Staff", "korean": "주문하시겠어요?", "meaning": "Are you ready to order?" },
      {
        "speaker": "You",
        "korean": "아이스 아메리카노 한 잔 주세요.",
        "meaning": "One iced americano, please."
      },
      { "speaker": "Staff", "korean": "드시고 가세요?", "meaning": "For here?" },
      { "speaker": "You", "korean": "아니요, 가져갈게요.", "meaning": "No, to go." },
      {
        "speaker": "Staff",
        "korean": "카드 여기 꽂아 주세요.",
        "meaning": "Please insert your card here."
      },
      { "speaker": "Staff", "korean": "진동벨 드릴게요.", "meaning": "Here is your buzzer." }
    ],
    "phrases": [
      {
        "id": "phrase-cafe-01",
        "korean": "아이스 아메리카노 한 잔 주세요.",
        "meaning": "One iced americano, please."
      },
      { "id": "phrase-cafe-02", "korean": "따뜻한 걸로 주세요.", "meaning": "A hot one, please." },
      {
        "id": "phrase-cafe-03",
        "korean": "드시고 가세요?",
        "meaning": "For here? (you will hear this)"
      },
      { "id": "phrase-cafe-04", "korean": "여기서 먹을 거예요.", "meaning": "For here." },
      { "id": "phrase-cafe-05", "korean": "가져갈게요.", "meaning": "To go." },
      { "id": "phrase-cafe-06", "korean": "덜 달게 해 주세요.", "meaning": "Less sweet, please." },
      { "id": "phrase-cafe-07", "korean": "와이파이 돼요?", "meaning": "Is there Wi-Fi?" },
      {
        "id": "phrase-cafe-08",
        "korean": "콘센트 있어요?",
        "meaning": "Is there a power socket?",
        "note": "콘센트 is the everyday word for a wall socket."
      },
      {
        "id": "phrase-cafe-09",
        "korean": "화장실 비밀번호가 뭐예요?",
        "meaning": "What is the restroom code?",
        "note": "Many cafe restrooms have a keypad; the code is often on the receipt."
      },
      {
        "id": "phrase-cafe-10",
        "korean": "진동벨 드릴게요.",
        "meaning": "Here is your buzzer. (you will hear this)",
        "note": "It buzzes when your order is ready; collect it at the counter."
      }
    ],
    "refs": ["grammar-12-requests", "grammar-10-future"]
  },
  {
    "id": "phrases-convenience-store",
    "title": "Convenience store",
    "situation": "Paying at the counter, bags, heating up a lunch box, and topping up a transit card.",
    "dialogue": [
      { "speaker": "Staff", "korean": "어서 오세요.", "meaning": "Welcome." },
      { "speaker": "You", "korean": "이거 데워 주세요.", "meaning": "Please heat this up." },
      { "speaker": "Staff", "korean": "봉투 필요하세요?", "meaning": "Do you need a bag?" },
      {
        "speaker": "You",
        "korean": "아니요, 괜찮아요. 카드로 할게요.",
        "meaning": "No, thanks. I'll pay by card."
      },
      {
        "speaker": "Staff",
        "korean": "영수증 드릴까요?",
        "meaning": "Would you like the receipt?"
      },
      { "speaker": "You", "korean": "아니요, 버려 주세요.", "meaning": "No, please throw it away." }
    ],
    "phrases": [
      {
        "id": "phrase-store-01",
        "korean": "봉투 필요하세요?",
        "meaning": "Do you need a bag? (you will hear this)",
        "note": "Bags usually cost a little extra."
      },
      { "id": "phrase-store-02", "korean": "봉투 하나 주세요.", "meaning": "One bag, please." },
      { "id": "phrase-store-03", "korean": "이거 데워 주세요.", "meaning": "Please heat this up." },
      { "id": "phrase-store-04", "korean": "젓가락 주세요.", "meaning": "Chopsticks, please." },
      { "id": "phrase-store-05", "korean": "카드로 할게요.", "meaning": "I'll pay by card." },
      { "id": "phrase-store-06", "korean": "현금으로 할게요.", "meaning": "I'll pay in cash." },
      {
        "id": "phrase-store-07",
        "korean": "교통카드 충전해 주세요.",
        "meaning": "Please top up my transit card.",
        "note": "Top-ups at the counter are usually paid in cash."
      },
      {
        "id": "phrase-store-08",
        "korean": "영수증 드릴까요?",
        "meaning": "Would you like the receipt? (you will hear this)"
      },
      { "id": "phrase-store-09", "korean": "영수증 주세요.", "meaning": "The receipt, please." },
      {
        "id": "phrase-store-10",
        "korean": "괜찮아요.",
        "meaning": "It's fine. / No, thank you.",
        "note": "A soft, polite way to say no to an offer."
      }
    ],
    "refs": ["grammar-12-requests"]
  },
  {
    "id": "phrases-shopping",
    "title": "Shopping and prices",
    "situation": "Asking prices, sizes and colours, trying things on, and paying. Bargaining only happens at traditional markets.",
    "dialogue": [
      { "speaker": "You", "korean": "이거 얼마예요?", "meaning": "How much is this?" },
      { "speaker": "Staff", "korean": "만 오천 원이에요.", "meaning": "It's 15,000 won." },
      { "speaker": "You", "korean": "다른 색 있어요?", "meaning": "Do you have other colours?" },
      {
        "speaker": "Staff",
        "korean": "네, 검은색하고 흰색이 있어요.",
        "meaning": "Yes, black and white."
      },
      { "speaker": "You", "korean": "입어 봐도 돼요?", "meaning": "Can I try it on?" },
      {
        "speaker": "Staff",
        "korean": "네, 탈의실은 저쪽이에요.",
        "meaning": "Yes, the fitting room is over there."
      },
      {
        "speaker": "You",
        "korean": "이걸로 할게요. 카드 돼요?",
        "meaning": "I'll take this. Can I pay by card?"
      }
    ],
    "phrases": [
      { "id": "phrase-shop-01", "korean": "이거 얼마예요?", "meaning": "How much is this?" },
      { "id": "phrase-shop-02", "korean": "너무 비싸요.", "meaning": "It's too expensive." },
      {
        "id": "phrase-shop-03",
        "korean": "좀 깎아 주세요.",
        "meaning": "Could you give me a discount?",
        "note": "Only at traditional markets and small stalls, not in shops with price tags."
      },
      {
        "id": "phrase-shop-04",
        "korean": "다른 색 있어요?",
        "meaning": "Do you have other colours?"
      },
      {
        "id": "phrase-shop-05",
        "korean": "더 큰 거 있어요?",
        "meaning": "Do you have a bigger one?"
      },
      { "id": "phrase-shop-06", "korean": "입어 봐도 돼요?", "meaning": "Can I try it on?" },
      { "id": "phrase-shop-07", "korean": "그냥 구경하는 거예요.", "meaning": "I'm just looking." },
      { "id": "phrase-shop-08", "korean": "이걸로 할게요.", "meaning": "I'll take this one." },
      { "id": "phrase-shop-09", "korean": "카드 돼요?", "meaning": "Can I pay by card?" },
      { "id": "phrase-shop-10", "korean": "환불돼요?", "meaning": "Can I get a refund?" }
    ],
    "refs": ["grammar-13-questions", "grammar-14-existence"]
  },
  {
    "id": "phrases-transport",
    "title": "Bus, subway and taxi",
    "situation": "Telling a taxi driver where to go, checking which bus to take, and getting off at the right stop.",
    "dialogue": [
      { "speaker": "Driver", "korean": "어디로 가세요?", "meaning": "Where are you going?" },
      { "speaker": "You", "korean": "유니스트로 가 주세요.", "meaning": "To UNIST, please." },
      { "speaker": "You", "korean": "얼마나 걸려요?", "meaning": "How long does it take?" },
      { "speaker": "Driver", "korean": "이십 분 정도 걸려요.", "meaning": "About twenty minutes." },
      {
        "speaker": "You",
        "korean": "여기서 세워 주세요. 카드 돼요?",
        "meaning": "Please stop here. Can I pay by card?"
      },
      { "speaker": "Driver", "korean": "네, 돼요.", "meaning": "Yes, you can." }
    ],
    "phrases": [
      { "id": "phrase-move-01", "korean": "유니스트로 가 주세요.", "meaning": "To UNIST, please." },
      {
        "id": "phrase-move-02",
        "korean": "이 주소로 가 주세요.",
        "meaning": "To this address, please.",
        "note": "Show the address in Korean on your phone."
      },
      { "id": "phrase-move-03", "korean": "여기서 세워 주세요.", "meaning": "Please stop here." },
      { "id": "phrase-move-04", "korean": "얼마나 걸려요?", "meaning": "How long does it take?" },
      {
        "id": "phrase-move-05",
        "korean": "이 버스 울산역에 가요?",
        "meaning": "Does this bus go to Ulsan Station?"
      },
      {
        "id": "phrase-move-06",
        "korean": "몇 번 버스를 타야 돼요?",
        "meaning": "Which bus number should I take?"
      },
      { "id": "phrase-move-07", "korean": "어디에서 내려요?", "meaning": "Where do I get off?" },
      { "id": "phrase-move-08", "korean": "갈아타야 돼요?", "meaning": "Do I need to transfer?" },
      {
        "id": "phrase-move-09",
        "korean": "다음 역은 어디예요?",
        "meaning": "What is the next station?"
      },
      {
        "id": "phrase-move-10",
        "korean": "교통카드는 어디서 사요?",
        "meaning": "Where can I buy a transit card?"
      }
    ],
    "refs": ["grammar-12-requests", "grammar-06-place-time"]
  },
  {
    "id": "phrases-directions",
    "title": "Asking directions",
    "situation": "Stopping someone politely, asking where a place is, and understanding left, right and straight on.",
    "dialogue": [
      {
        "speaker": "You",
        "korean": "실례합니다. 이 근처에 편의점이 있어요?",
        "meaning": "Excuse me. Is there a convenience store near here?"
      },
      {
        "speaker": "Passer-by",
        "korean": "네, 저기 은행 옆에 있어요.",
        "meaning": "Yes, over there next to the bank."
      },
      { "speaker": "You", "korean": "여기서 멀어요?", "meaning": "Is it far from here?" },
      {
        "speaker": "Passer-by",
        "korean": "아니요, 가까워요. 쭉 가서 오른쪽으로 가세요.",
        "meaning": "No, it's close. Go straight on, then turn right."
      },
      { "speaker": "You", "korean": "감사합니다!", "meaning": "Thank you!" }
    ],
    "phrases": [
      {
        "id": "phrase-way-01",
        "korean": "실례합니다.",
        "meaning": "Excuse me.",
        "note": "Use it before asking a stranger something."
      },
      {
        "id": "phrase-way-02",
        "korean": "화장실이 어디예요?",
        "meaning": "Where is the restroom?"
      },
      {
        "id": "phrase-way-03",
        "korean": "이 근처에 약국 있어요?",
        "meaning": "Is there a pharmacy near here?"
      },
      { "id": "phrase-way-04", "korean": "여기서 멀어요?", "meaning": "Is it far from here?" },
      { "id": "phrase-way-05", "korean": "걸어서 갈 수 있어요?", "meaning": "Can I walk there?" },
      { "id": "phrase-way-06", "korean": "쭉 가세요.", "meaning": "Go straight on." },
      { "id": "phrase-way-07", "korean": "오른쪽으로 가세요.", "meaning": "Turn right." },
      { "id": "phrase-way-08", "korean": "왼쪽으로 가세요.", "meaning": "Turn left." },
      { "id": "phrase-way-09", "korean": "길을 잃었어요.", "meaning": "I'm lost." },
      { "id": "phrase-way-10", "korean": "천천히 말해 주세요.", "meaning": "Please speak slowly." },
      {
        "id": "phrase-way-11",
